{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kizz-tech/council/schemas/product-bet-evaluation-model-output.schema.json",
  "title": "Product Bet evaluation model output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route",
    "route_reason",
    "evidence_atoms",
    "function_admissions",
    "consultation_ledger",
    "critical_unknowns",
    "alternatives",
    "recommendation",
    "dissent",
    "handoff",
    "aftercare_baseline"
  ],
  "properties": {
    "route": {
      "enum": ["direct", "single", "council", "not-ready"]
    },
    "route_reason": {
      "type": "string",
      "minLength": 12
    },
    "evidence_atoms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceAtom"
      }
    },
    "function_admissions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/functionAdmission"
      }
    },
    "consultation_ledger": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/consultationEntry"
      }
    },
    "critical_unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommendation": {
      "enum": [
        "commit",
        "hold-for-evidence",
        "revise",
        "reject",
        "escalate-to-owner"
      ]
    },
    "dissent": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "handoff": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/handoff"
        }
      ]
    },
    "aftercare_baseline": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/aftercareBaseline"
        }
      ]
    }
  },
  "$defs": {
    "evidenceAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_id",
        "kind",
        "statement",
        "evidence_refs",
        "as_of",
        "question",
        "evidence_owner",
        "next_evidence",
        "forecast"
      ],
      "properties": {
        "atom_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "observed",
            "source-bound",
            "inferred",
            "assumed",
            "forecast",
            "judgment",
            "unknown"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "as_of": {
          "type": ["string", "null"]
        },
        "question": {
          "type": ["string", "null"]
        },
        "evidence_owner": {
          "type": ["string", "null"]
        },
        "next_evidence": {
          "type": ["string", "null"]
        },
        "forecast": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["measure", "baseline", "target", "horizon"],
              "properties": {
                "measure": {"type": "string", "minLength": 1},
                "baseline": {"type": "string", "minLength": 1},
                "target": {"type": "string", "minLength": 1},
                "horizon": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "functionAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function_id",
        "protected_failure",
        "evidence_path",
        "decision_delta",
        "countercase",
        "overlap_difference",
        "authority",
        "budget"
      ],
      "properties": {
        "function_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "protected_failure": {"type": "string", "minLength": 1},
        "evidence_path": {"type": "string", "minLength": 1},
        "decision_delta": {"type": "string", "minLength": 1},
        "countercase": {"type": "string", "minLength": 1},
        "overlap_difference": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "budget": {"type": "string", "minLength": 1}
      }
    },
    "consultationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function_id", "executor_type", "status", "finding_id"],
      "properties": {
        "function_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "executor_type": {
          "type": "string",
          "const": "independent-subagent"
        },
        "status": {
          "type": "string",
          "const": "completed"
        },
        "finding_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_authority_id",
        "required_owning_system_gates",
        "external_action_taken"
      ],
      "properties": {
        "decision_authority_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "required_owning_system_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "external_action_taken": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "aftercareBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_sha256",
        "measures",
        "horizon",
        "stop_triggers",
        "immutable"
      ],
      "properties": {
        "brief_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "measures": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "horizon": {"type": "string", "minLength": 1},
        "stop_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "immutable": {"type": "boolean", "const": true}
      }
    }
  }
}
